# Supabase local (npx supabase start — ver chaves em `npx supabase status`)
# Usadas no frontend (client anon) — NUNCA usar service_role aqui.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_XXX

# Chave secreta (service_role) — SOMENTE no servidor (server/** e api/**), nunca no client.
VITE_SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXX

# Porta do backend local (server/index.ts) — o Vite faz proxy de /api para esta porta.
PORT=8787

# Licença PrimeUI (PrimeVue 5) — community (grátis) ou comercial; remove o aviso no console.
VITE_PRIMEUI_LICENSE_KEY=
